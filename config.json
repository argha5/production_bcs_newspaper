{
  "//models": "Bynara Router (https://router.bynara.id/) provides 7M tokens/day with an OpenAI-compatible API. Quality-critical calls prefer the larger model, mechanical ones the smaller — each list doubles as a fallback chain.",
  "models": {
    "study": ["google/gemini-2.5-flash", "llama-3.3-70b-versatile", "google/gemini-2.0-flash"],
    "qna": ["google/gemini-2.5-flash", "llama-3.3-70b-versatile", "google/gemini-2.0-flash"],
    "translate": ["google/gemini-2.0-flash", "llama-3.1-8b-instant"],
    "dissect": ["google/gemini-2.0-flash", "llama-3.1-8b-instant"]
  },

  "//budget": "Bynara provides 7 million tokens/day. A full 9-article edition uses roughly ~300k tokens, well within limits.",
  "dailyTokenBudget": 6000000,
  "englishPerDay": 5,
  "bengaliPerDay": 4,

  "minArticleWordsEn": 250,
  "minArticleWordsBn": 300,
  "maxArticleAgeDays": 4,

  "//tokens": "Every request must fit prompt + reserved output inside the provider's ceiling.",
  "maxArticleTokens": 3000,
  "translationChunkTokens": 1500,
  "maxSentencesPerArticle": 50,
  "sentenceBatchSize": 10,
  "qnaBatchSize": 2,

  "glossaryWords": 20,
  "qnaPerArticle": 5,

  "//answers": "BCS Written answers run 220-320 words. Anything under minAnswerWords is regenerated once with the short draft shown to the model.",
  "minAnswerWords": 190,

  "keepEditionsInIndex": 7,
  "pruneDataOlderThanDays": 45,

  "feeds": [
    { "lang": "en", "source": "The Daily Star", "url": "https://www.thedailystar.net/opinion/rss.xml", "editorial": true },
    { "lang": "en", "source": "The Daily Star", "url": "https://www.thedailystar.net/rss.xml" },
    { "lang": "en", "source": "The Business Standard", "url": "https://www.tbsnews.net/thoughts/rss.xml", "editorial": true },
    { "lang": "en", "source": "The Business Standard", "url": "https://www.tbsnews.net/economy/rss.xml" },
    { "lang": "en", "source": "The Business Standard", "url": "https://www.tbsnews.net/rss.xml" },

    { "lang": "bn", "source": "প্রথম আলো", "url": "https://www.prothomalo.com/feed/", "editorial": true },
    { "lang": "bn", "source": "দৈনিক সমকাল", "url": "https://samakal.com/rss.xml", "editorial": true },
    { "lang": "bn", "source": "দৈনিক বণিক বার্তা", "url": "https://bonikbarta.net/feed", "editorial": true },
    { "lang": "bn", "source": "দ্য বিজনেস স্ট্যান্ডার্ড", "url": "https://www.tbsnews.net/bangla/opinion/rss.xml", "editorial": true },
    { "lang": "bn", "source": "দ্য বিজনেস স্ট্যান্ডার্ড", "url": "https://www.tbsnews.net/bangla/rss.xml" },
    { "lang": "bn", "source": "আজকের পত্রিকা", "url": "https://www.ajkerpatrika.com/feed" },
    { "lang": "bn", "source": "দ্য ডেইলি স্টার বাংলা", "url": "https://bangla.thedailystar.net/rss.xml" }
  ]
}
